# --- LLM brain ---
TONY_LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Gateway ---
TONY_PORT=8787
TONY_API_TOKEN=tony-dev-token
TONY_MAX_ITERATIONS=8
TONY_USER_NAME=Muhammad Afzal
TONY_COMPANION_MODE=true

# --- Voicebox (own voice) ---
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE=Farman
VOICEBOX_CLIENT_ID=tony-ai
# Keep this model pinned in Voicebox RAM (gateway + daemon warm it on boot)
VOICEBOX_TTS_MODEL=qwen-tts-1.7B
VOICEBOX_STT_MODEL=whisper-base
# Emotion / style hint for Farman TTS (override auto-detect)
# VOICEBOX_INSTRUCT=warm, expressive, natural emotion; witty Jarvis tone
VOICEBOX_MAX_CHARS=320
# Optional: force a Voicebox engine (leave empty for default). Farman clone uses qwen.
# VOICEBOX_ENGINE=

# --- Python tool bridge ---
TONY_BRIDGE_URL=http://127.0.0.1:8790
TONY_BRIDGE_TOKEN=tony-bridge-token
# Leave empty to use repo root; or set an absolute workspace path
TONY_BRIDGE_WORKSPACE=

# --- Memory / daemon ---
TONY_DATA_DIR=./data
TONY_VAULT_DIR=./vault
TONY_DAEMON_ENABLED=true
TONY_DAEMON_HEALTH_MS=3600000
TONY_DAEMON_LEARN_HOUR=3

# --- Persona ---
TONY_PERSONA=witty Jarvis-style assistant: expert at coding, research, writing, bug fixing, and full desktop control; fluent in English, Urdu script, and Roman Urdu; crack light jokes; stay helpful and local-first
