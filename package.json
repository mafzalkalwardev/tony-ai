{
  "name": "tony-ai",
  "version": "2.2.0-phase4",
  "description": "Hybrid Tony — Phase 4 skills learning + recharged command deck HUD",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node agent/src/gateway/server.js",
    "charlie": "node agent/src/gateway/server.js",
    "charlie:watch": "node --watch agent/src/gateway/server.js",
    "tony:daemon": "node agent/src/daemon/index.js",
    "bridge": "python -m bridge.server",
    "live": "node agent/src/live.js",
    "chat": "node agent/src/cli.js chat",
    "run": "node agent/src/cli.js run",
    "health": "node agent/src/cli.js health",
    "test:agent": "node agent/scripts/smoke-test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
